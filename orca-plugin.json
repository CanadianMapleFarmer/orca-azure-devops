{
  "manifestVersion": 2,
  "id": "azure-devops",
  "name": "Azure DevOps",
  "version": "0.1.0",
  "description": "Unofficial. Azure DevOps work items, boards, pipelines, pull requests and wikis in the Orca sidebar.",
  "icon": "assets/icon.png",
  "author": {
    "name": "Gerhard Kloppers",
    "url": "https://github.com/CanadianMapleFarmer"
  },
  "license": "MIT",
  "repository": "https://github.com/CanadianMapleFarmer/orca-azure-devops",
  "homepage": "https://github.com/CanadianMapleFarmer/orca-azure-devops",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker/main.ts",
  "contributes": {
    "panels": [
      {
        "id": "ado",
        "title": "Azure DevOps",
        "icon": "cloud",
        "entry": "src/panel/panel.tsx",
        "ui": "components"
      }
    ],
    "customEditors": [
      {
        "id": "board",
        "title": "Azure DevOps board",
        "extensions": [
          ".adoboard"
        ],
        "entry": "src/board/board.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "run",
        "title": "Azure DevOps run",
        "extensions": [
          ".adorun"
        ],
        "entry": "src/run/run.html",
        "priority": "default",
        "frame": "isolated"
      }
    ],
    "newFiles": [
      {
        "id": "board",
        "title": "Azure DevOps board",
        "extension": ".adoboard"
      }
    ],
    "commands": [
      {
        "id": "status",
        "title": "Azure DevOps: Connection status"
      }
    ],
    "statusBarItems": [
      {
        "id": "status",
        "text": "ADO",
        "icon": "cloud",
        "tooltip": "Azure DevOps",
        "command": "status"
      }
    ],
    "settings": [
      {
        "key": "azPath",
        "title": "Azure CLI path",
        "description": "Leave empty to find az automatically.",
        "type": "string",
        "default": "",
        "placeholder": "/opt/homebrew/bin/az"
      },
      {
        "key": "defaultAgent",
        "title": "Default agent",
        "description": "The agent \"Start an agent\" launches, such as claude or codex.",
        "type": "string",
        "default": "claude",
        "placeholder": "claude"
      },
      {
        "key": "agentContext",
        "title": "Add work item context to agent prompts",
        "type": "boolean",
        "default": false
      },
      {
        "key": "branchTemplate",
        "title": "Branch name template",
        "description": "{id} is the work item id and {slug} its title.",
        "type": "string",
        "default": "feature/{id}-{slug}"
      },
      {
        "key": "autoCompleteMergeStrategy",
        "title": "Auto-complete merge type",
        "type": "string",
        "enum": [
          "noFastForward",
          "squash",
          "rebase",
          "rebaseMerge"
        ],
        "enumLabels": [
          "Merge (no fast-forward)",
          "Squash commit",
          "Rebase and fast-forward",
          "Semi-linear merge"
        ],
        "default": "noFastForward"
      },
      {
        "key": "autoCompleteDeleteSourceBranch",
        "title": "Auto-complete: delete the source branch",
        "type": "boolean",
        "default": false
      },
      {
        "key": "autoCompleteTransitionWorkItems",
        "title": "Auto-complete: complete linked work items",
        "type": "boolean",
        "default": false
      },
      {
        "key": "shareTemplate",
        "title": "Pull request share line",
        "description": "One line per pull request. [text]({url}) is the link. Also {repo}, {project}, {source}, {target}, {author}.",
        "type": "string",
        "default": "[Pull Request {id}]({url}): {title}"
      },
      {
        "key": "notifyRunFailures",
        "title": "Notify when my pipeline runs fail",
        "type": "boolean",
        "default": true
      },
      {
        "key": "notifyApprovals",
        "title": "Notify when a run waits for approval",
        "description": "Your runs, and approvals you can give.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "notifyWatchedRuns",
        "title": "Notify when a watched run finishes",
        "type": "boolean",
        "default": true
      },
      {
        "key": "approvalShareTemplate",
        "title": "Approval share line",
        "description": "One line per approval. [text]({url}) is the link. Also {stage}, {requestedBy}, {project}.",
        "type": "string",
        "default": "Approval needed for {environment}: [{pipeline} {run}]({url}) on {branch}"
      },
      {
        "key": "entraClientId",
        "title": "Microsoft sign-in: app (client) ID",
        "description": "From the app registration your admin created. See the README's admin guide.",
        "type": "string",
        "default": "",
        "placeholder": "00000000-0000-0000-0000-000000000000",
        "maxLength": 36
      },
      {
        "key": "entraTenant",
        "title": "Microsoft sign-in: tenant",
        "description": "Used only when an organization's tenant can't be found. A tenant ID or domain; leave empty for any work or school account.",
        "type": "string",
        "default": "",
        "placeholder": "your-tenant.onmicrosoft.com",
        "maxLength": 253
      },
      {
        "key": "httpsProxy",
        "title": "HTTPS proxy",
        "description": "Send the plugin's Azure DevOps and Microsoft traffic through this proxy, like http://proxy.example.com:8080. Proxies that need a password aren't supported.",
        "type": "string",
        "default": "",
        "placeholder": "http://proxy.example.com:8080"
      },
      {
        "key": "caCertificatesFile",
        "title": "Extra CA certificates file",
        "description": "A PEM file of certificates to trust, for networks that inspect TLS.",
        "type": "string",
        "default": "",
        "placeholder": "/path/to/ca-certificates.pem"
      },
      {
        "key": "useSystemCertificates",
        "title": "Trust the system's certificates",
        "description": "Also trust the certificates your operating system trusts.",
        "type": "boolean",
        "default": false
      }
    ],
    "hooks": [
      {
        "event": "workspace.create.before"
      },
      {
        "event": "workspace.create.after"
      },
      {
        "event": "agent.prompt.before"
      },
      {
        "event": "agent.launch.before"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
