{
  "manifestVersion": 2,
  "id": "azure-devops",
  "name": "Azure DevOps",
  "version": "0.1.0",
  "description": "Azure DevOps work items, pipelines, pull requests and wikis in the Orca sidebar.",
  "license": "MIT",
  "repository": "https://github.com/CanadianMapleFarmer/orca-azure-devops",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker/main.ts",
  "contributes": {
    "panels": [
      {
        "id": "ado",
        "title": "Azure DevOps",
        "icon": "cloud",
        "entry": "src/panel/panel.tsx",
        "ui": "components"
      }
    ],
    "customEditors": [
      {
        "id": "board",
        "title": "Azure DevOps board",
        "extensions": [
          ".adoboard"
        ],
        "entry": "src/board/board.html",
        "priority": "default",
        "frame": "isolated"
      }
    ],
    "newFiles": [
      {
        "id": "board",
        "title": "Azure DevOps board",
        "extension": ".adoboard"
      }
    ],
    "commands": [
      {
        "id": "status",
        "title": "Azure DevOps: Connection status"
      }
    ],
    "statusBarItems": [
      {
        "id": "status",
        "text": "ADO",
        "icon": "cloud",
        "tooltip": "Azure DevOps",
        "command": "status"
      }
    ],
    "settings": [
      {
        "key": "azPath",
        "title": "Azure CLI path",
        "description": "Leave empty to find az automatically.",
        "type": "string",
        "default": "",
        "placeholder": "/opt/homebrew/bin/az"
      },
      {
        "key": "defaultAgent",
        "title": "Default agent",
        "description": "The agent \"Start an agent\" launches, such as claude or codex.",
        "type": "string",
        "default": "claude",
        "placeholder": "claude"
      },
      {
        "key": "agentContext",
        "title": "Add work item context to agent prompts",
        "type": "boolean",
        "default": false
      },
      {
        "key": "branchTemplate",
        "title": "Branch name template",
        "description": "{id} is the work item id and {slug} its title.",
        "type": "string",
        "default": "feature/{id}-{slug}"
      },
      {
        "key": "autoCompleteMergeStrategy",
        "title": "Auto-complete merge type",
        "type": "string",
        "enum": [
          "noFastForward",
          "squash",
          "rebase",
          "rebaseMerge"
        ],
        "enumLabels": [
          "Merge (no fast-forward)",
          "Squash commit",
          "Rebase and fast-forward",
          "Semi-linear merge"
        ],
        "default": "noFastForward"
      },
      {
        "key": "autoCompleteDeleteSourceBranch",
        "title": "Auto-complete: delete the source branch",
        "type": "boolean",
        "default": false
      },
      {
        "key": "autoCompleteTransitionWorkItems",
        "title": "Auto-complete: complete linked work items",
        "type": "boolean",
        "default": false
      },
      {
        "key": "shareTemplate",
        "title": "Pull request share line",
        "description": "One line per pull request. [text]({url}) is the link. Also {repo}, {project}, {source}, {target}, {author}.",
        "type": "string",
        "default": "[Pull Request {id}]({url}): {title}"
      }
    ],
    "hooks": [
      {
        "event": "workspace.create.before"
      },
      {
        "event": "workspace.create.after"
      },
      {
        "event": "agent.prompt.before"
      },
      {
        "event": "agent.launch.before"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "agent:launch"
    }
  ]
}
